.tools/
dist/
# build/ is generated by wails build, except the app icon (exe, window, installer and shortcuts)
!build/
build/*
!build/appicon.png
!build/windows/
build/windows/*
!build/windows/icon.ico
# the NSIS project is versioned (wails keeps an existing one): it also installs LICENSE
!build/windows/installer/
build/windows/installer/*
!build/windows/installer/project.nsi
frontend/dist/
frontend/package.json.md5
/mdb2sql
# filled from .tools by scripts/build_w11.ps1 (mdbtools, DuckDB sqlite extension)
backend/embedded/*
!backend/embedded/.gitkeep
# the small generated Access file of the tests is versioned (the root .gitignore ignores *.mdb)
!backend/testdata/types.mdb
