{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDB2SQL",
  "version": "0.1.0",
  "identifier": "com.mdb2sql.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../ui && pnpm install && pnpm run dev",
    "beforeBuildCommand": "cd ../ui && pnpm install && pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MDB2SQL",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
