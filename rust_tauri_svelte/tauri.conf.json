{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDB2SQL",
  "version": "1.0.0",
  "identifier": "com.mdb2sql.app",
  "build": {
    "beforeDevCommand": "pnpm --filter mdb2sql-ui run dev",
    "beforeBuildCommand": "pnpm --filter mdb2sql-ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MDB2SQL",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
