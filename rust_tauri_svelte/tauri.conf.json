{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "cd ui && npm run dev",
    "beforeBuildCommand": "cd ui && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "bundle": {
    "active": false,
    "identifier": "com.mdb2sql.app",
    "targets": "all"
  },
  "productName": "MDB2SQL",
  "version": "0.1.0",
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "MDB2SQL",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
